{
  "name": "noticebridge-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:showcase": "tsc --noEmit && vite build --mode showcase --outDir dist-showcase",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:showcase": "playwright test --config playwright.showcase.config.ts",
    "evaluate:retrieval": "vite build --ssr evaluation/run.ts --outDir .evaluation-build && node .evaluation-build/run.js",
    "compose:retrieval": "vite build --ssr evaluation/compose.ts --outDir .evaluation-build && node .evaluation-build/compose.js",
    "compare:retrieval": "vite build --ssr evaluation/compare.ts --outDir .evaluation-build && node .evaluation-build/compare.js",
    "verify:packet": "vite build --ssr evaluation/verifyPacket.ts --outDir .evaluation-build && node .evaluation-build/verifyPacket.js",
    "agree:retrieval": "vite build --ssr evaluation/agree.ts --outDir .evaluation-build && node .evaluation-build/agree.js",
    "reconcile:retrieval": "vite build --ssr evaluation/reconcile.ts --outDir .evaluation-build && node .evaluation-build/reconcile.js",
    "qualify:retrieval": "vite build --ssr evaluation/qualify.ts --outDir .evaluation-build && node .evaluation-build/qualify.js",
    "verify:checklist": "vite build --ssr evaluation/verifyChecklist.ts --outDir .evaluation-build && node .evaluation-build/verifyChecklist.js",
    "compare:checklist": "vite build --ssr evaluation/compareChecklist.ts --outDir .evaluation-build && node .evaluation-build/compareChecklist.js",
    "uncertainty:retrieval": "vite build --ssr evaluation/uncertainty.ts --outDir .evaluation-build && node .evaluation-build/uncertainty.js",
    "verify:alignment": "vite build --ssr evaluation/verifyAlignment.ts --outDir .evaluation-build && node .evaluation-build/verifyAlignment.js",
    "preflight:retrieval": "vite build --ssr evaluation/preflight.ts --outDir .evaluation-build && node .evaluation-build/preflight.js",
    "review:preflight": "vite build --ssr evaluation/reviewPreflight.ts --outDir .evaluation-build && node .evaluation-build/reviewPreflight.js",
    "qualify:study": "vite build --ssr evaluation/qualifyStudy.ts --outDir .evaluation-build && node .evaluation-build/qualifyStudy.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pdfjs-dist": "~5.4.624"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@playwright/test": "1.65.1"
  }
}
