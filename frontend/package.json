{
  "name": "noticebridge-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:showcase": "tsc --noEmit && vite build --mode showcase --outDir dist-showcase",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:showcase": "playwright test --config playwright.showcase.config.ts",
    "evaluate:retrieval": "vite build --ssr evaluation/run.ts --outDir .evaluation-build && node .evaluation-build/run.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pdfjs-dist": "~5.4.624"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@playwright/test": "1.65.1"
  }
}
